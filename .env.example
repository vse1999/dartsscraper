OLLAMA_MODEL=gemma4:12b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_KEEP_ALIVE=30m
CHAT_HOST=127.0.0.1
CHAT_PORT=3210

# Owner-only Telegram bot (Vercel webhook)
BOT_TOKEN=replace_with_botfather_token
ALLOWED_USER_ID=replace_with_your_numeric_telegram_user_id
WEBHOOK_SECRET=replace_with_32_or_more_random_letters_digits_underscores_or_hyphens
CRON_SECRET=replace_with_32_or_more_random_letters_digits_underscores_or_hyphens
# Optional outside Vercel; points the Telegram /modus command at the report endpoint.
# MODUS_REPORT_URL=http://127.0.0.1:3000/api/daily-modus-report
# Optional, disabled unless explicitly set to true. Enables owner-only live
# read-only odds/value research; source prices are not alerts or recommendations.
ODDS_FETCH_ENABLED=false
# Optional on Windows/local hosts. Leave unset to use the bundled serverless
# Chromium path or the runtime's default browser.
# ODDS_BROWSER_EXECUTABLE_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
# Optional single-host evidence retention; leave false/unset on Vercel.
# RESEARCH_LOCAL_LEDGER_ENABLED=true
