{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/telegram-webhook.ts": {
      "maxDuration": 300,
      "includeFiles": "{node_modules/@sparticuz/chromium/bin/**,public/fonts/**,node_modules/@resvg/resvg-js-linux-*/**}"
    },
    "api/daily-modus-report.ts": {
      "maxDuration": 180,
      "includeFiles": "{public/fonts/**,node_modules/@resvg/resvg-js-linux-*/**}"
    },
    "api/pdc-report.ts": {
      "maxDuration": 300,
      "includeFiles": "{public/fonts/**,node_modules/@resvg/resvg-js-linux-*/**}"
    }
  },
  "crons": [
    {
      "path": "/api/daily-modus-report",
      "schedule": "0 17 * * *"
    }
  ]
}
